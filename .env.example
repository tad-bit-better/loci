# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so only put public keys here.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# RevenueCat → Project → API keys (public SDK keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx

# Server-side secrets never go here. (No AI or server secrets are used yet: see docs/DECISIONS.md.)
